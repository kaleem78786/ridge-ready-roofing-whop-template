{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ridge-ready-roofing",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
