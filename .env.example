# Copy to .dev.vars for local Cloudflare/Vite development. Never commit .dev.vars.
# Whop sandbox and production credentials/catalogs are separate.
WHOP_ENVIRONMENT=sandbox
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_INSPECTION_PLAN_ID=
WHOP_DEPOSIT_PLAN_ID=
WHOP_REPAIR_PLAN_ID=
WHOP_INSPECTION_PRICE=149
WHOP_DEPOSIT_PRICE=500
WHOP_REPAIR_PRICE=399
# At least 32 random characters; example generation: openssl rand -hex 32
APP_SESSION_SECRET=
# At least 16 characters; use a unique strong owner password.
ADMIN_PASSWORD=
# Signing secret of the Whop webhook registered for /api/webhooks/whop.
WHOP_WEBHOOK_SECRET=
# Production checkout stays disabled until explicitly enabled by the merchant.
WHOP_ENABLE_LIVE_PAYMENTS=false
# Optional /sandbox test checkout; these never replace production resources.
WHOP_SANDBOX_ACCOUNT_ID=
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_INSPECTION_PLAN_ID=
WHOP_SANDBOX_DEPOSIT_PLAN_ID=
WHOP_SANDBOX_REPAIR_PLAN_ID=
WHOP_SANDBOX_WEBHOOK_SECRET=
# Used by the catalog provisioning script. Keep aligned with src/config.ts.
ROOFING_COMPANY_NAME=Ridge & Ready
